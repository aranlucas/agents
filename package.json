{
  "name": "agents-monorepo",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently \"pnpm --filter web dev\" \"docker compose up --build agents telegram\" --names web,runtimes --prefix-colors blue,green --kill-others",
    "dev:web": "pnpm --filter web dev",
    "dev:telegram": "docker compose up --build telegram",
    "dev:oral-boards": "pnpm --filter oral-boards dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:railway": "pnpm env:railway && pnpm dev",
    "env:railway": "railway variables --json | jq -r 'to_entries[] | \"\\(.key)=\\(.value|@sh)\"' > .env.local",
    "dev:agents": "docker compose up --build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "check": "turbo run lint typecheck fmt:check contracts:check api:check",
    "test": "turbo test --concurrency=2",
    "coverage": "turbo coverage",
    "fmt": "turbo fmt",
    "fmt:check": "turbo fmt:check",
    "typecheck": "turbo typecheck",
    "contracts:generate": "pnpm --filter agents contracts:generate",
    "contracts:check": "turbo contracts:check",
    "api:generate": "pnpm --filter agents api:generate",
    "api:check": "turbo api:check",
    "graph": "turbo graph",
    "build": "turbo build --filter='!mobile'",
    "update": "pnpm update:js && pnpm update:expo",
    "update:js": "pnpm up -r --latest",
    "update:expo": "cd apps/mobile && pnpx expo@latest install expo@latest && pnpx expo@latest install --fix && pnpx expo-doctor",
    "doctor": "react-doctor"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tailwindcss": "1.3.5",
    "oxlint-tsgolint": "^7.0.2001",
    "railway": "^3.7.0",
    "react-doctor": "^0.9.3",
    "supports-color": "11.0.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.8"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.20.0"
}
