{
  "name": "agents-monorepo",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently \"pnpm --filter web dev\" \"docker compose up --build agents telegram\" --names web,runtimes --prefix-colors blue,green --kill-others",
    "dev:web": "pnpm --filter web dev",
    "dev:telegram": "docker compose up --build telegram",
    "dev:oral-boards": "pnpm --filter oral-boards dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:railway": "pnpm env:railway && pnpm dev",
    "env:railway": "railway variables --json | jq -r 'to_entries[] | \"\\(.key)=\\(.value|@sh)\"' > .env.local",
    "dev:agents": "docker compose up --build",
    "lint": "nice -n 10 turbo lint --concurrency=1",
    "lint:fix": "nice -n 10 turbo lint:fix --concurrency=1",
    "check": "nice -n 10 turbo run lint typecheck fmt:check contracts:check api:check --concurrency=1",
    "test": "nice -n 10 turbo test --concurrency=1",
    "coverage": "nice -n 10 turbo coverage --concurrency=1",
    "fmt": "nice -n 10 turbo fmt --concurrency=1",
    "fmt:check": "nice -n 10 turbo fmt:check --concurrency=1",
    "typecheck": "nice -n 10 turbo typecheck --concurrency=1",
    "contracts:generate": "pnpm --filter agents contracts:generate",
    "contracts:check": "nice -n 10 turbo contracts:check --concurrency=1",
    "api:generate": "pnpm --filter agents api:generate",
    "api:check": "nice -n 10 turbo api:check --concurrency=1",
    "graph": "turbo graph",
    "build": "nice -n 10 turbo build --filter='!mobile' --concurrency=1",
    "update": "pnpm update:js && pnpm update:expo",
    "update:js": "pnpm up -r --latest",
    "update:expo": "cd apps/mobile && pnpm dlx expo@latest install expo@latest && pnpm dlx expo@latest install --fix && pnpm dlx expo-doctor",
    "doctor": "react-doctor"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tailwindcss": "1.10.2",
    "oxlint-tsgolint": "^7.0.2001",
    "railway": "^3.11.0",
    "react-doctor": "^0.9.13",
    "supports-color": "11.0.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@12.3.4"
}
