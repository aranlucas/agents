{
  "name": "agents-monorepo",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently \"pnpm --filter web dev\" \"docker compose up --build agents telegram\" --names web,runtimes --prefix-colors blue,green --kill-others",
    "dev:web": "pnpm --filter web dev",
    "dev:telegram": "docker compose up --build telegram",
    "dev:web:offline": "pnpm --filter web dev:offline",
    "dev:oral-boards": "pnpm --filter oral-boards dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:railway": "pnpm env:railway && pnpm dev",
    "env:railway": "railway variables --json | jq -r 'to_entries[] | \"\\(.key)=\\(.value|@sh)\"' > .env.local",
    "dev:agents": "docker compose up --build",
    "lint": "turbo lint",
    "check": "turbo run lint typecheck fmt",
    "test": "turbo test --concurrency=2",
    "test:web:offline": "pnpm --filter web test:offline",
    "coverage": "turbo coverage",
    "fmt": "turbo fmt",
    "fmt:check": "turbo fmt:check",
    "typecheck": "turbo typecheck",
    "graph": "turbo graph",
    "build": "turbo build",
    "update": "pnpm update:js && pnpm update:expo",
    "update:js": "pnpm up -r --latest",
    "update:expo": "cd apps/mobile && pnpx expo@latest install expo@latest && pnpx expo@latest install --fix && pnpx expo-doctor",
    "doctor": "pnpx react-doctor@latest"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "react-doctor": "^0.7.1",
    "turbo": "^2.10.4"
  },
  "packageManager": "pnpm@11.10.0"
}
