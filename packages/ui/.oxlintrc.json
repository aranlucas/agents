{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../oxlint-config/base.json", "../oxlint-config/tailwind.json"],
  "jsPlugins": ["oxlint-tailwindcss"],
  "plugins": ["import", "jsx-a11y", "react", "typescript", "unicorn"],
  "settings": {
    "react": {
      "version": "19.2.7"
    },
    "tailwindcss": {
      "entryPoint": "src/styles/globals.css",
      "timeout": 300000
    }
  },
  "rules": {
    "tailwindcss/no-arbitrary-value": [
      "error",
      {
        "allow": [
          "-inset-e-(--",
          "-inset-s-(--",
          "aspect-(--",
          "bg-(--",
          "border-(--",
          "gap-(--",
          "h-(--",
          "max-h-(--",
          "max-w-(--",
          "min-w-(--",
          "origin-(--",
          "p-(--",
          "pb-(--",
          "px-(--",
          "py-(--",
          "rounded-(--",
          "rounded-e-(--",
          "rounded-s-(--",
          "size-(--",
          "text-(--",
          "w-(--"
        ]
      }
    ],
    "react/self-closing-comp": "warn",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["src/components/ai-elements/code-block.tsx", "src/components/tabs.tsx"],
      "rules": {
        "tailwindcss/no-dark-without-light": "off"
      }
    },
    {
      "files": ["src/components/ai-elements/**"],
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/media-has-caption": "off",
        "jsx-a11y/heading-has-content": "off",
        "react/jsx-key": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/no-useless-default-assignment": "off",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-floating-promises": "off",
        "typescript/consistent-return": "off",
        "typescript/prefer-nullish-coalescing": "off",
        "typescript/prefer-optional-chain": "off",
        "react/self-closing-comp": "off"
      }
    },
    {
      "files": ["src/components/ai-elements/persona.tsx"],
      "rules": {
        "react/immutability": "off"
      }
    },
    {
      "files": [
        "src/components/pagination.tsx",
        "src/components/label.tsx",
        "src/components/input-group.tsx"
      ],
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/test/**"],
      "rules": {
        "jsx-a11y/aria-role": "off",
        "jsx-a11y/heading-has-content": "off"
      }
    }
  ]
}
