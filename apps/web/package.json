{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:offline": "AGENT_TEST_MODE=offline NEXT_PUBLIC_AGENT_TEST_MODE=offline next dev --turbopack",
    "build": "COPILOTKIT_TELEMETRY_DISABLED=true next build",
    "start": "next start",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:offline": "AGENT_TEST_MODE=offline NEXT_PUBLIC_AGENT_TEST_MODE=offline vitest run -t offline",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agents/types": "workspace:*",
    "@agents/ui": "workspace:*",
    "@clerk/nextjs": "^7.5.14",
    "@copilotkit/a2ui-renderer": "^1.62.2",
    "@copilotkit/react-core": "^1.62.2",
    "@copilotkit/runtime": "^1.62.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/otel": "^2.1.3",
    "groq-sdk": "^1.3.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agents/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eas-cli": "^20.5.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.7",
    "tailwindcss": "^4.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@7.0.1-rc",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@ag-ui/client": "0.0.57"
  }
}
