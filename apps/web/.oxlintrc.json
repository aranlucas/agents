{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../packages/oxlint-config/base.json",
    "../../packages/oxlint-config/tailwind.json"
  ],
  "jsPlugins": ["oxlint-tailwindcss"],
  "plugins": ["import", "jsx-a11y", "nextjs", "react", "typescript", "unicorn"],
  "settings": {
    "next": {
      "rootDir": "."
    },
    "react": {
      "version": "19.2.7"
    },
    "tailwindcss": {
      "entryPoint": "../../packages/ui/src/styles/globals.css"
    }
  },
  "rules": {
    "react/self-closing-comp": "warn",
    "react/react-in-jsx-scope": "off",
    "react-hooks/exhaustive-deps": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react-test-renderer",
            "message": "react-test-renderer is deprecated; use @testing-library/react instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/test/**"],
      "rules": {
        "jsx-a11y/aria-role": "off",
        "jsx-a11y/heading-has-content": "off"
      }
    }
  ],
  "ignorePatterns": [".next/**"]
}
