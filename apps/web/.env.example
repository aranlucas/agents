# Agent URLs
NEXT_PUBLIC_AGENTS_BASE_URL=http://localhost:8000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Sentry errors and distributed tracing (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-only org:ci token used by withSentryConfig to upload private source maps.
# Store this as a sensitive Vercel environment variable; never expose it with
# a NEXT_PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=
COPILOTKIT_DEBUG=false

# Agent model providers.
# For local Docker agents, set these in the repo root .env.local.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_NIM_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HUGGING_FACE_API_KEY=
# Required — voice transcription for oral boards (https://console.groq.com)
# GROQ_API_KEY also enables the Groq model fallback above.
GROQ_API_KEY=gsk_your_key_here
