# Agent URLs
TRAVEL_AGENT_URL=http://localhost:8000
GROCERY_AGENT_URL=http://localhost:8001
FITNESS_AGENT_URL=http://localhost:8002
WELLNESS_AGENT_URL=http://localhost:8003
A2UI_AGENT_URL=http://localhost:8004

# Optional shared ADK session database overrides for agent services.
# Local Docker defaults to ADK_SESSION_DB_PATH=/data/adk_sessions.sqlite.
# For Turso/libSQL, set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN on each agent.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agents-nextjs
COPILOTKIT_DEBUG=false

# Agent model providers.
# For local Docker agents, set these in the repo root .env.local.
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_NIM_API_KEY=
