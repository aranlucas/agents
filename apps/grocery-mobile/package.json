{
  "name": "grocery-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "concurrently --kill-others --names metro,sync \"expo start\" \"pnpm _syncPnpm --watch\"",
    "_syncPnpm": "pnpm sync-dependencies-meta-injected",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:preview:android": "npx eas-cli build --profile preview --platform android",
    "build:production:android": "npx eas-cli build --profile production --platform android",
    "build:production-apk:android": "node ./scripts/android-release.mjs build",
    "publish:production-apk:android": "node ./scripts/android-release.mjs publish",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agents/native-markdown": "workspace:*",
    "@agents/types": "workspace:*",
    "@clerk/clerk-expo": "^2.19.31",
    "@copilotkit/react-native": "^1.63.0",
    "@expo/metro-runtime": "~57.0.5",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.6",
    "expo-asset": "~57.0.5",
    "expo-auth-session": "~57.0.3",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.3",
    "pnpm-sync-dependencies-meta-injected": "^0.0.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "dependenciesMeta": {
    "@agents/native-markdown": {
      "injected": true
    }
  }
}
