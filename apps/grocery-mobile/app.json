{
  "expo": {
    "name": "Grocery Agent",
    "slug": "grocery-agent",
    "owner": "aranlucas",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "grocery-agent",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f8f2",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.agents.grocery",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.agents.grocery",
      "versionCode": 3,
      "allowBackup": false,
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#14532d"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#f7f8f2"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-system-ui",
        {
          "android": {
            "edgeToEdge": true
          }
        }
      ],
      "expo-secure-store",
      "./plugins/with-expo-dev-launcher-always-run"
    ],
    "extra": {
      "clerkPublishableKey": "",
      "copilotKitRuntimeUrl": "https://agents-gateway.up.railway.app",
      "marketingBaseUrl": "https://agents-lucas.vercel.app/grocery",
      "router": {},
      "eas": {
        "projectId": "72e1079f-c7ef-425c-b2d7-10dec7598c78"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
