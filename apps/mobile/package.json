{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:env:production": "npx eas-cli@latest env:list production --format long",
    "eas:env:pull:production": "npx eas-cli@latest env:pull production --path .env.local",
    "build:preview:android": "npx eas-cli@latest build --profile preview --platform android",
    "build:production:android": "npx eas-cli@latest build --profile production --platform android",
    "build:production:all": "npx eas-cli@latest build --profile production --platform all",
    "build:local:preview:android": "npx eas-cli@latest env:exec preview \"npx eas-cli@latest build --profile preview --platform android --local\"",
    "build:local:production:android": "npx eas-cli@latest env:exec production \"npx eas-cli@latest build --profile production --platform android --local\"",
    "build:local:production:android:env-file": "sh -c 'if [ -f .env.local ]; then set -a; . ./.env.local; set +a; fi; npx eas-cli@latest build --profile production --platform android --local'",
    "lint": "pnpm --workspace-root lint",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ag-ui/a2ui-middleware": "0.0.8",
    "@ag-ui/client": "^0.0.56",
    "@agents/types": "workspace:*",
    "@ai-sdk/react": "^3.0.202",
    "@clerk/clerk-expo": "^2.19.31",
    "@copilotkit/react-native": "^1.60.0",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/ui": "~56.0.17",
    "@legendapp/list": "^3.0.4",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-tooltip": "^1.2.9",
    "clsx": "^2.1.1",
    "connect": "^3.7.0",
    "css-to-react-native": "^3.2.0",
    "expo": "^56.0.11",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.17",
    "expo-auth-session": "~56.0.14",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.6",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "lucide-react": "^1.17.0",
    "lucide-react-native": "^1.17.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-keyboard-controller": "^1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.3",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/react": "~19.2.17",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.2.7",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
