{
  "name": "mobile",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "concurrently --kill-others --names metro,sync \"expo start\" \"pnpm _syncPnpm --watch\"",
    "_syncPnpm": "pnpm sync-dependencies-meta-injected",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:env:production": "npx eas-cli env:list production --format long",
    "eas:env:pull:production": "npx eas-cli env:pull production --path .env.local",
    "build": "node scripts/with-android-sdk-env.mjs npx eas-cli build --profile production --platform android --local",
    "build:android": "npx eas-cli build --profile production --platform android",
    "build:preview": "npx eas-cli build --profile preview --platform android",
    "build:preview:android": "npx eas-cli build --profile preview --platform android",
    "build:production:android": "npx eas-cli build --profile production --platform android",
    "build:production:all": "npx eas-cli build --profile production --platform all",
    "build:local:preview:android": "node scripts/with-android-sdk-env.mjs npx eas-cli env:exec preview \"npx eas-cli build --profile preview --platform android --local\"",
    "build:local:production:android": "node scripts/with-android-sdk-env.mjs npx eas-cli env:exec production \"npx eas-cli build --profile production --platform android --local\"",
    "build:local:production:android:env-file": "sh -c 'if [ -f .env.local ]; then set -a; . ./.env.local; set +a; fi; node scripts/with-android-sdk-env.mjs npx eas-cli build --profile production --platform android --local'",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agents/native-markdown": "workspace:*",
    "@agents/types": "workspace:*",
    "@clerk/expo": "^4.6.1",
    "@copilotkit/react-native": "^1.69.3",
    "@expo/metro-runtime": "57.0.14",
    "@sentry/react-native": "~7.11.0",
    "expo": "^57.0.18",
    "expo-asset": "~57.0.15",
    "expo-auth-session": "~57.0.10",
    "expo-build-properties": "^57.0.15",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "bufferutil": "4.1.0",
    "concurrently": "^10.0.5",
    "pnpm-sync-dependencies-meta-injected": "^0.0.15",
    "react-test-renderer": "19.2.3",
    "supports-color": "11.0.0",
    "typescript": "6.0.3",
    "utf-8-validate": "6.0.6",
    "vitest": "^4.1.11"
  },
  "dependenciesMeta": {
    "@agents/native-markdown": {
      "injected": true
    }
  }
}
