{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:env:production": "npx eas-cli env:list production --format long",
    "eas:env:pull:production": "npx eas-cli env:pull production --path .env.local",
    "build": "npx eas-cli build --profile production --platform android --local",
    "build:android": "npx eas-cli build --profile production --platform android",
    "build:preview": "npx eas-cli build --profile preview --platform android",
    "build:preview:android": "npx eas-cli build --profile preview --platform android",
    "build:production:android": "npx eas-cli build --profile production --platform android",
    "build:production:all": "npx eas-cli build --profile production --platform all",
    "build:local:preview:android": "npx eas-cli env:exec preview \"npx eas-cli build --profile preview --platform android --local\"",
    "build:local:production:android": "npx eas-cli env:exec production \"npx eas-cli build --profile production --platform android --local\"",
    "build:local:production:android:env-file": "sh -c 'if [ -f .env.local ]; then set -a; . ./.env.local; set +a; fi; npx eas-cli build --profile production --platform android --local'",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@agents/types": "workspace:*",
    "@clerk/clerk-expo": "^2.19.31",
    "@copilotkit/react-native": "^1.62.2",
    "@expo/metro-runtime": "~57.0.3",
    "@expo/ui": "~57.0.3",
    "@legendapp/list": "^3.3.2",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-tooltip": "^1.2.12",
    "clsx": "^2.1.1",
    "css-to-react-native": "^3.2.0",
    "expo": "^57.0.2",
    "expo-application": "~57.0.0",
    "expo-asset": "~57.0.3",
    "expo-auth-session": "~57.0.1",
    "expo-blur": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "lucide-react": "^1.23.0",
    "lucide-react-native": "^1.23.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.0",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/react": "~19.2.17",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.2.7",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
