EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Preferred for production APKs: points mobile at the web CopilotKit runtime,
# which streams directly and resolves server-side Clerk OAuth provider tokens.
EXPO_PUBLIC_COPILOTKIT_RUNTIME_URL=https://your-web-app.example.com/api/copilotkit

# Local direct-agent development fallback. Ignored when
# EXPO_PUBLIC_COPILOTKIT_RUNTIME_URL is set. Every agent is mounted beneath this
# one gateway base URL.
EXPO_PUBLIC_AGENTS_BASE_URL=http://localhost:8000
