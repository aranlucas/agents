EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Preferred for production APKs: points mobile at the web CopilotKit runtime,
# which injects A2UI tooling and resolves server-side Clerk OAuth provider tokens.
EXPO_PUBLIC_COPILOTKIT_RUNTIME_URL=https://your-web-app.example.com/api/copilotkit

# Local direct-agent development fallback. Ignored when EXPO_PUBLIC_COPILOTKIT_RUNTIME_URL is set.
EXPO_PUBLIC_TRAVEL_AGENT_URL=http://localhost:8000/
EXPO_PUBLIC_GROCERY_AGENT_URL=http://localhost:8001/
EXPO_PUBLIC_FITNESS_AGENT_URL=http://localhost:8002/
EXPO_PUBLIC_WELLNESS_AGENT_URL=http://localhost:8003/
EXPO_PUBLIC_A2UI_AGENT_URL=http://localhost:8004/
