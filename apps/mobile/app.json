{
  "expo": {
    "name": "Travel Agent",
    "slug": "agents",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "agents",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.agents.mobile",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.agents.mobile",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      ["expo-system-ui", { "android": { "edgeToEdge": true } }],
      "expo-secure-store",
      "./modules/health-data/app.plugin.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "clerkPublishableKey": "pk_test_bG9naWNhbC12aXBlci0zMy5jbGVyay5hY2NvdW50cy5kZXYk",
      "copilotKitRuntimeUrl": "https://agents-gateway-production.up.railway.app",
      "agentsBaseUrl": "https://agents-gateway-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "55635582-fffb-4745-913d-ae2dae61fbe8"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
