{
  "expo": {
    "name": "agents",
    "slug": "agents",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "agents",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.agents.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-system-ui",
      "expo-secure-store"
    ],
    "extra": {
      "clerkPublishableKey": "",
      "copilotKitRuntimeUrl": "",
      "travelAgentUrl": "http://localhost:8000/",
      "groceryAgentUrl": "http://localhost:8001/",
      "fitnessAgentUrl": "http://localhost:8002/",
      "wellnessAgentUrl": "http://localhost:8003/",
      "a2uiAgentUrl": "http://localhost:8004/"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
