{
  "type": "object",
  "properties": {
    "fitness_data_connected": {
      "type": "boolean"
    },
    "activity_source": {
      "type": "string"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["health_connect", "healthkit", "strava", "strava_import"]
          },
          "sport_type": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "distance_m": {
            "type": "number"
          },
          "moving_time_s": {
            "type": "integer"
          },
          "elapsed_time_s": {
            "type": "integer"
          },
          "total_elevation_gain_m": {
            "type": "number"
          },
          "average_heartrate": {
            "type": "number"
          },
          "perceived_effort": {
            "type": "integer"
          },
          "data_origin": {
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "activities_synced_at": {
      "type": "string"
    },
    "objective_research": {
      "type": "string"
    },
    "training_plan": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["idle", "syncing", "planning", "ready"]
    },
    "review_summary": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FitnessState",
  "additionalProperties": false
}
