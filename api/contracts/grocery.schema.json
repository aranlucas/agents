{
  "type": "object",
  "properties": {
    "shopping_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "list_title": {
      "type": "string"
    },
    "product_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "upc": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "size": {
            "type": "string"
          }
        },
        "required": ["query", "name", "upc"],
        "additionalProperties": false
      }
    },
    "cart": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "type": "number"
          },
          "upc": {
            "type": "string"
          }
        },
        "required": ["name", "quantity"],
        "additionalProperties": false
      }
    },
    "shopping_profile": {
      "type": "object",
      "properties": {
        "pantry": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "added_at": {
                "type": "integer"
              },
              "expires_at": {
                "type": "integer"
              }
            },
            "required": ["name", "quantity", "added_at"],
            "additionalProperties": false
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "added_at": {
                "type": "integer"
              },
              "category": {
                "type": "string"
              }
            },
            "required": ["name", "added_at"],
            "additionalProperties": false
          }
        },
        "recent_orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "upc": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "price": {
                      "type": "number"
                    }
                  },
                  "required": ["upc", "name", "quantity"],
                  "additionalProperties": false
                }
              },
              "total_items": {
                "type": "integer"
              },
              "placed_at": {
                "type": "integer"
              },
              "estimated_total": {
                "type": "number"
              },
              "location_id": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": ["id", "items", "total_items", "placed_at"],
            "additionalProperties": false
          }
        },
        "frequent_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "upc": {
                "type": "string"
              },
              "orders": {
                "type": "integer"
              },
              "total_quantity": {
                "type": "integer"
              }
            },
            "required": ["name", "upc", "orders", "total_quantity"],
            "additionalProperties": false
          }
        },
        "preferred_store": {
          "type": "object",
          "properties": {
            "location_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "chain": {
              "type": "string"
            },
            "set_at": {
              "type": "integer"
            }
          },
          "required": ["location_id", "name", "address", "chain", "set_at"],
          "additionalProperties": false
        }
      },
      "required": ["pantry", "equipment", "recent_orders", "frequent_items"],
      "additionalProperties": false
    },
    "meal_plan": {
      "type": "string"
    },
    "recipe": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "servings": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": ["name", "quantity", "unit", "note"],
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["title", "description", "servings", "notes", "ingredients", "steps", "tags"],
      "additionalProperties": false
    },
    "weekly_deals": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["idle", "planning", "ready"]
    },
    "notes": {
      "type": "string"
    },
    "review_summary": {
      "type": "string"
    },
    "kroger_connected": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroceryState",
  "additionalProperties": false
}
