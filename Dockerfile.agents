FROM python:3.14.5-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates nodejs npm gcc python3-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    AGENT_DIR="agents/travel" \
    PYTHONPATH="/app/agents/a2ui/src:/app/agents/fitness/src:/app/agents/gateway/src:/app/agents/grocery/src:/app/agents/oralboards/src:/app/agents/resume/src:/app/agents/shared/src:/app/agents/travel/src:/app/agents/wellness/src"

# Dependency layer: only the root manifest + lockfile, so third-party installs
# are cached until dependencies change.
COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev

COPY . ./

RUN uv sync --frozen --no-dev

CMD ["sh", "-c", "cd /app && agent_name=$(basename ${AGENT_DIR}) && module=${AGENT_MODULE:-${agent_name}_agent.main} && uvicorn ${module}:app --host 0.0.0.0 --port ${PORT:-8000}"]
