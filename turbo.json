{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheMaxAge": "14d",
  "cacheMaxSize": "10GB",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "SKIP_ENV_VALIDATION",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_AGENTS_BASE_URL",
        "CLERK_SECRET_KEY",
        "AGENTS_BASE_URL",
        "TRVL_MCP_URL",
        "KROGER_MCP_URL",
        "MISTRAL_API_KEY",
        "OPENROUTER_API_KEY",
        "HUGGING_FACE_API_KEY",
        "GROQ_API_KEY",
        "TELEGRAM_LINK_SECRET",
        "TELEGRAM_BOT_TOKEN",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME",
        "COPILOTKIT_DEBUG"
      ]
    },
    "oral-boards#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "agents#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "fmt": {
      "cache": false
    },
    "fmt:check": {},
    "contracts:check": {
      "cache": false
    },
    "api:check": {
      "cache": false
    },
    "test": {},
    "coverage": {
      "outputs": ["coverage/**"]
    },
    "agents#coverage": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage.out"]
    }
  }
}
