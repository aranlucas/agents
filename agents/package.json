{
  "name": "agents",
  "private": true,
  "scripts": {
    "lint": "golangci-lint run ./...",
    "dev": "go run ./cmd/gateway",
    "fmt": "go run mvdan.cc/gofumpt@v0.10.0 -w .",
    "fmt:check": "test -z \"$(go run mvdan.cc/gofumpt@v0.10.0 -l .)\"",
    "typecheck": "go vet ./...",
    "build": "CGO_ENABLED=0 go build -mod=readonly -trimpath -o ./bin/gateway ./cmd/gateway && CGO_ENABLED=0 go build -mod=readonly -trimpath -o ./bin/telegram ./cmd/telegram",
    "test": "go test -race ./...",
    "coverage": "go test -race -coverprofile=coverage.out ./...",
    "vulncheck": "go run golang.org/x/vuln/cmd/govulncheck@v1.6.0 ./...",
    "contracts:generate": "go run ./cmd/contracts",
    "contracts:check": "go run ./cmd/contracts -check"
  }
}
