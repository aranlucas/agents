{
  "name": "agents",
  "private": true,
  "scripts": {
    "lint": "golangci-lint run ./...",
    "fmt": "gofmt -w $(find . -name '*.go' -not -path './vendor/*')",
    "fmt:check": "test -z \"$(gofmt -l $(find . -name '*.go' -not -path './vendor/*'))\"",
    "typecheck": "go vet ./...",
    "build": "go build -o ./bin/gateway ./cmd/gateway && go build -o ./bin/telegram ./cmd/telegram",
    "test": "go test -race ./...",
    "coverage": "go test -race -coverprofile=coverage.out ./..."
  }
}
