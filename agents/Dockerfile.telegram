# syntax=docker/dockerfile:1.7
FROM golang:1.26.5-bookworm AS build
WORKDIR /src/agents
COPY agents/go.mod agents/go.sum ./
RUN --mount=type=cache,id=agents-go-mod,target=/go/pkg/mod,sharing=locked \
    go mod download
COPY agents/ ./
RUN --mount=type=cache,id=agents-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=agents-go-build,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/telegram ./cmd/telegram && \
    CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/telegram /app/telegram
COPY --from=build /out/migrate /app/migrate
COPY --from=build /src/agents/assets /app/assets
USER nonroot:nonroot
ENTRYPOINT ["/app/telegram"]
