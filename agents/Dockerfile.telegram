# syntax=docker/dockerfile:1.7
FROM golang:1.27.0-bookworm AS build
WORKDIR /src/agents
COPY agents/go.mod agents/go.sum ./
RUN go mod download
COPY agents/ ./
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/ ./cmd/telegram ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/telegram /app/telegram
COPY --from=build /out/migrate /app/migrate
COPY --from=build /src/agents/assets /app/assets
USER nonroot:nonroot
ENTRYPOINT ["/app/telegram"]
