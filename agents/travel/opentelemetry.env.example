# ADK OpenTelemetry configuration — add these to Railway environment variables.
# See: https://docs.cloud.google.com/stackdriver/docs/instrumentation/ai-agent-adk

OTEL_SERVICE_NAME=doctor-adk-agent

# Required for gen_ai semantic conventions (LLM spans, token counts, etc.)
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Captures message content in events (not attributes) to avoid size limit violations
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# Prevents ADK from duplicating message content into span attributes
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Enable auto-instrumentation of Python logging
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

# Railway OTLP collector endpoint (already set by Railway when OTEL collector is added)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-railway-otel-collector>
