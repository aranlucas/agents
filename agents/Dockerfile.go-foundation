# syntax=docker/dockerfile:1.7
#
# Go gateway foundation image: builds and serves cmd/gateway with no Python
# interpreter, virtualenv, uv, Node runtime, npm packages, or compiler
# toolchain in the final image. This is the vertical-slice foundation image
# (currently the /resume agent only) verified by
# agents/scripts/smoke-image.sh; it does not replace agents/Dockerfile (the
# production Python gateway) until the port/cutover plan completes.
#
# Build from the repo root:
#   docker build -f agents/Dockerfile.go-foundation -t agents-go-foundation:local .

FROM golang:1.26-bookworm AS build
WORKDIR /src/agents
COPY agents/go.mod agents/go.sum ./
RUN go mod download
COPY agents/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/gateway ./cmd/gateway

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gateway /app/gateway
USER nonroot:nonroot
ENTRYPOINT ["/app/gateway"]
