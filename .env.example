# Copy to .env — single file for all services.
# apps/web reads it via: next dev --env-file ../../.env
# apps/mobile reads it via a symlink: apps/mobile/.env -> ../../.env

# ── Clerk (https://dashboard.clerk.com → API Keys) ────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...   # same key, Expo prefix

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Agent URLs ─────────────────────────────────────────────────────────────────
TRAVEL_AGENT_URL=http://localhost:8000/
GROCERY_AGENT_URL=http://localhost:8001/
EXPO_PUBLIC_TRAVEL_AGENT_URL=http://localhost:8000/
EXPO_PUBLIC_GROCERY_AGENT_URL=http://localhost:8001/

# ── Travel agent ───────────────────────────────────────────────────────────────
TRVL_MCP_URL=https://trvl-production.up.railway.app/mcp

# ── Grocery agent ──────────────────────────────────────────────────────────────
KROGER_MCP_URL=https://mcp.kroger.com/mcp

# ── OpenTelemetry (optional) ───────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agents-nextjs
COPILOTKIT_DEBUG=false
