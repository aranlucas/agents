# Copy to .env for `make dev`; production values belong in Railway.

APP_ENV=development

# ── Persistence ──────────────────────────────────────────────────────────────
# SQLite database file, created and migrated on startup. Defaults to
# .data/agents.db (git-ignored).
DATABASE_PATH=

# ── Clerk (https://dashboard.clerk.com → API Keys) ────────────────────────────
CLERK_SECRET_KEY=sk_test_...

# ── Agent URLs ─────────────────────────────────────────────────────────────────
# All agents are served by one gateway service; per-agent endpoints live at
# <base>/<agent>/agui (e.g. http://localhost:8000/travel/agui).
AGENTS_BASE_URL=http://localhost:8000
# Browser origins accepted by the gateway. Development may use a wildcard;
# production requires a comma-separated list of exact HTTPS origins.
ALLOWED_ORIGINS=*

# ── Travel agent ───────────────────────────────────────────────────────────────
TRVL_MCP_URL=https://trvl-production.up.railway.app/mcp

# ── Grocery agent ──────────────────────────────────────────────────────────────
KROGER_MCP_URL=https://ai-meal-planner-mcp.aranlucas.workers.dev/mcp

# ── Fitness agent ──────────────────────────────────────────────────────────────
BRAVE_API_KEY=

# ── Agent model providers ─────────────────────────────────────────────────────
# Production gateway composition requires Groq, NVIDIA NIM, Mistral,
# and OpenRouter.
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Enables error reporting and native Sentry request tracing. Health checks are
# excluded from performance traces.
SENTRY_DSN=

# ── Agent endpoint auth ────────────────────────────────────────────────────────
# JWKS endpoint of the Clerk instance (Dashboard -> API Keys -> Show JWT public
# key, or https://<your-clerk-frontend-api>/.well-known/jwks.json). Production
# requires both values; development defaults to the repository's test tenant.
CLERK_JWKS_URL=
CLERK_ISSUER=
# Telegram bot adapter
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_BASE_URL=
TELEGRAM_LINK_SECRET=
# Optional explicit settings URL. Defaults to the same origin as TELEGRAM_LINK_BASE_URL plus /console/settings.
TELEGRAM_CONNECT_URL=
# Optional comma-separated allowlist. Leave empty to allow every chat that can reach the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
