# Copy to .env and fill in values

# === Agent URLs (used by apps/web) ===
TRAVEL_AGENT_URL=http://localhost:8000/
GROCERY_AGENT_URL=http://localhost:8001/

# === Clerk (create app at clerk.com) ===
# Add to apps/web/.env.local:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#   CLERK_SECRET_KEY=sk_test_...
# Add to apps/mobile/.env:
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# === Travel agent (agents/travel/.env) ===
# TRVL_MCP_URL=https://trvl-production.up.railway.app/mcp
# OTEL_EXPORTER_OTLP_ENDPOINT=

# === Grocery agent (agents/grocery/.env) ===
