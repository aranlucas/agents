# Choose ONE of the following model paths.

# Default: Google Gemini (recommended for shared-state streaming).
GOOGLE_API_KEY=your-google-api-key

# Optional override: route through Mistral via LiteLLM.
# USE_MISTRAL=1
# MISTRAL_API_KEY=your-mistral-api-key

# Where the Next.js runtime proxies AG-UI requests.
AGENT_URL=http://localhost:8000
