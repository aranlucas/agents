# Copy to .env for `make dev`; production values belong in Railway.

APP_ENV=development

# ── Persistence ──────────────────────────────────────────────────────────────
# SQLite database file, created and migrated on startup. Defaults to
# .data/agents.db (git-ignored).
DATABASE_PATH=

# ── Clerk (https://dashboard.clerk.com → API Keys) ────────────────────────────
CLERK_SECRET_KEY=sk_test_...

# ── Agent URLs ─────────────────────────────────────────────────────────────────
# Per-agent endpoints live at <base>/<agent>/agui.
# Browser origins: comma-separated origins or *. Prefer exact HTTPS origins
# in production; local HTTP origins are also accepted.
ALLOWED_ORIGINS=*

# ── Travel agent ───────────────────────────────────────────────────────────────
TRVL_MCP_URL=https://trvl-production.up.railway.app/mcp

# ── Grocery agent ──────────────────────────────────────────────────────────────
KROGER_MCP_URL=https://ai-meal-planner-mcp.aranlucas.workers.dev/mcp

# ── Fitness agent ──────────────────────────────────────────────────────────────
BRAVE_API_KEY=

# ── Agent model providers ─────────────────────────────────────────────────────
# Gateway startup requires Groq and OpenRouter. NVIDIA and Mistral are optional.
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ── Trends agent ──────────────────────────────────────────────────────────────
# Required at gateway startup: one-line service-account JSON; project_id bills
# BigQuery queries against the public Trends dataset. Keep this value private.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Enables error reporting and native Sentry request tracing. Health checks are
# excluded from performance traces.
SENTRY_DSN=

# ── Agent endpoint auth ────────────────────────────────────────────────────────
# JWKS endpoint of the Clerk instance (Dashboard -> API Keys -> Show JWT public
# key, or https://<your-clerk-frontend-api>/.well-known/jwks.json). Production
# requires both values; development defaults to the repository's test tenant.
CLERK_JWKS_URL=
CLERK_ISSUER=
