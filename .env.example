# Copy to .env for Docker Compose. Copy the relevant client variables to
# apps/web/.env.local or apps/mobile/.env.local when running those apps outside
# Compose; production values belong in Railway, Vercel, and EAS respectively.

APP_ENV=development

# ── Mandatory Cloudflare persistence ──────────────────────────────────────────
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
CF_R2_BUCKET_NAME=adk-artifacts-dev
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# ── Clerk (https://dashboard.clerk.com → API Keys) ────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...   # same key, Expo prefix

# ── Agent URLs ─────────────────────────────────────────────────────────────────
# All agents are served by one gateway service; per-agent endpoints live at
# <base>/<agent>/agui (e.g. http://localhost:8000/travel/agui).
AGENTS_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AGENTS_BASE_URL=http://localhost:8000
# Browser origins accepted by the gateway. Development may use a wildcard;
# production requires a comma-separated list of exact HTTPS origins.
ALLOWED_ORIGINS=*
EXPO_PUBLIC_AGENTS_BASE_URL=http://localhost:8000

# ── Travel agent ───────────────────────────────────────────────────────────────
TRVL_MCP_URL=https://trvl-production.up.railway.app/mcp

# ── Grocery agent ──────────────────────────────────────────────────────────────
KROGER_MCP_URL=https://ai-meal-planner-mcp.aranlucas.workers.dev/mcp

# ── Fitness agent ──────────────────────────────────────────────────────────────
BRAVE_API_KEY=

# ── Agent model providers ─────────────────────────────────────────────────────
# The Docker agent services load .env and .env.local from the repo root.
# Production gateway composition requires Gemini, Groq, NVIDIA NIM, Mistral,
# and OpenRouter. Cerebras is available for local eval substitution.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ── OpenTelemetry (optional; OTLP over HTTP/protobuf) ─────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Agent endpoint auth ────────────────────────────────────────────────────────
# JWKS endpoint of the Clerk instance (Dashboard -> API Keys -> Show JWT public
# key, or https://<your-clerk-frontend-api>/.well-known/jwks.json). Production
# requires both values; development defaults to the repository's test tenant.
CLERK_JWKS_URL=
CLERK_ISSUER=
# Telegram bot adapter
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_BASE_URL=
TELEGRAM_LINK_SECRET=
# Optional explicit settings URL. Defaults to the same origin as TELEGRAM_LINK_BASE_URL plus /console/settings.
TELEGRAM_CONNECT_URL=
# Optional comma-separated allowlist. Leave empty to allow every chat that can reach the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
